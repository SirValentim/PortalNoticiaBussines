PORT=8080
APP_ENV=production
SITE_URL=https://inhumasemfoco.online
DB_DRIVER=sqlite
DATABASE_URL=/var/www/inhumas/inhumas.db
MIGRATIONS_DIR=/var/www/inhumas/migrations
SESSION_SECRET=change-this-to-at-least-32-random-bytes
PREVIOUS_SESSION_SECRET=
FORCE_SECURE_COOKIES=true
INITIAL_ADMIN_PASSWORD=change-this-before-first-start
ADMIN_PATH_PREFIX=/painel/7x9k2m
UPLOAD_DIR=/var/www/inhumas/uploads
STATIC_DIR=/var/www/inhumas/static
PROJECT_ROOT=/var/www/inhumas
METRICS_TOKEN=change-this-metrics-token-before-production
BACKUP_DIR=/var/backups/inhumas
BACKUP_SCRIPT=/var/www/inhumas/scripts/backup.sh
CSP_REPORT_ONLY=false
CSP_REPORT_URI=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Inhumas em Foco
MAX_UPLOAD_SIZE=2097152
BCRYPT_COST=12
ORIGINAL_RETENTION_DAYS=7
MAINTENANCE_MODE=false

# --------------------------------------------------
# TENANT BRANDING CONFIGURATION
# --------------------------------------------------

# Identidade do portal (obrigatorias)
PORTAL_NAME=Inhumas em Foco
PORTAL_TAGLINE=O portal de noticias que conecta Inhumas
PORTAL_DESCRIPTION=Portal local de noticias, eventos, comercio e comunidade de Inhumas, Goias.
PORTAL_LOCALE=pt_BR
PORTAL_LANGUAGE=pt-BR
PORTAL_CATEGORY=news

# Identidade visual
PORTAL_LOGO_PATH=/static/images/logo.png
PORTAL_LOGO_ALT=Inhumas em Foco
PORTAL_FAVICON_PATH=/static/images/logo.png
PORTAL_PRIMARY_COLOR=#1a4a3a
PORTAL_SECONDARY_COLOR=#f5c518
PORTAL_ACCENT_COLOR=#2d6a52

# SEO global
PORTAL_SEO_TITLE_SUFFIX= | Inhumas em Foco
PORTAL_SEO_DEFAULT_IMAGE=https://inhumasemfoco.online/static/images/inhumas-hero.png
PORTAL_TWITTER_HANDLE=@inhumasemfoco
PORTAL_FACEBOOK_PAGE_URL=
PORTAL_INSTAGRAM_HANDLE=

# Contato
PORTAL_CONTACT_EMAIL=contato@inhumasemfoco.online
PORTAL_CONTACT_PHONE=(62) 99999-9999
PORTAL_CONTACT_CITY=Inhumas
PORTAL_CONTACT_STATE=GO
PORTAL_CONTACT_COUNTRY=BR

# Editorial
PORTAL_ARTICLES_PER_PAGE=12
PORTAL_FEATURED_TAG_SLUG=destaque
PORTAL_BREAKING_NEWS_LABEL=Ao vivo
PORTAL_COPYRIGHT_HOLDER=Inhumas em Foco
PORTAL_FOOTER_LEGAL_TEXT=Todos os direitos reservados.

# Integracoes (deixar vazio para desabilitar)
PORTAL_GA_ID=
PORTAL_GTM_ID=
PORTAL_DISQUS_SHORTNAME=
PORTAL_RECAPTCHA_SITE_KEY=
OFFSITE_BACKUP_DIR=
RCLONE_REMOTE=
OFFSITE_MAX_AGE=48h
MAX_BACKUP_AGE_HOURS=26
DISK_ALERT_THRESHOLD=80
JOURNAL_RETENTION=14d
